# =============================================================================
# Open Digital Mentor — 配置
# =============================================================================
# 复制为 .env 后按需修改：  cp .env.example .env
#
# 【重要】不填任何 Key 也能完整运行。
#   默认全部 Provider 为 mock，Mock 模式下不会发起任何出站网络请求。
#   .env 已被 .gitignore 忽略，切勿提交。
# =============================================================================


# -----------------------------------------------------------------------------
# 运行模式
# -----------------------------------------------------------------------------
# mock  = 全部使用内置 Mock Provider，无需 Key，无出站网络（默认）
# live  = 使用下方配置的真实 Provider
ODM_MODE=mock


# -----------------------------------------------------------------------------
# 服务地址
# -----------------------------------------------------------------------------
# 默认只监听本机。改为 0.0.0.0 会暴露到整个局域网，启动时会打印醒目告警。
ODM_HOST=127.0.0.1
ODM_PORT=8000

# 前端地址白名单（CORS），逗号分隔。不要使用 *
ODM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NEXT_PUBLIC_* 会进入浏览器构建产物，只能放公开配置，绝不能放密钥。
# 前端连接后端的地址
NEXT_PUBLIC_ODM_WS_URL=ws://127.0.0.1:8000/ws


# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# mock | openai_compatible
ODM_LLM_PROVIDER=mock

# 任何 OpenAI 兼容端点均可（DeepSeek / 阿里云百炼 / 火山方舟 / Ollama / vLLM ...）
ODM_LLM_BASE_URL=
ODM_LLM_API_KEY=
ODM_LLM_MODEL=
ODM_LLM_TEMPERATURE=0.2
ODM_LLM_MAX_TOKENS=2048


# -----------------------------------------------------------------------------
# TTS Provider
# -----------------------------------------------------------------------------
# mock = 本地合成静音/正弦波，不联网
# minimax = MiniMax WebSocket TTS，支持系统音色与复刻 Voice ID
# azure = Azure Speech REST（可选兼容实现）
ODM_TTS_PROVIDER=mock

# 完整请求端点。留空时使用所选 Provider 的官方地址；代理/私有网关可在此覆盖。
# MiniMax 示例：wss://api.minimaxi.com/ws/v1/t2a_v2
# Azure 示例：https://eastasia.tts.speech.microsoft.com/cognitiveservices/v1
ODM_TTS_ENDPOINT=
ODM_TTS_API_KEY=
ODM_TTS_VOICE=
ODM_TTS_MODEL=speech-2.8-turbo

# 仅 Azure 需要 Region；使用 Azure 时 Voice 示例为 zh-CN-XiaoxiaoNeural。
ODM_TTS_REGION=


# -----------------------------------------------------------------------------
# Retriever
# -----------------------------------------------------------------------------
# mock | local
ODM_RETRIEVER=local

# 知识库目录（相对仓库根目录）。替换此目录即可换掉整个知识库。
ODM_KNOWLEDGE_DIR=knowledge

# 单次检索返回的条目数
ODM_RETRIEVER_TOP_K=4

# 相关度低于此阈值时视为「知识库未覆盖」，触发拒答
ODM_RETRIEVER_MIN_SCORE=0.15


# -----------------------------------------------------------------------------
# Avatar
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ODM_AVATAR_URL=/avatars/default.vrm

# stylized = 保留 MToon 卡通材质
# pbr      = 转换为 PBR 材质 + 三点光源（对部分模型效果不佳，可关）
NEXT_PUBLIC_ODM_RENDER_PRESET=stylized


# -----------------------------------------------------------------------------
# 限流与安全
# -----------------------------------------------------------------------------
ODM_MAX_MESSAGE_CHARS=2000
ODM_MAX_CONNECTIONS_PER_IP=5
ODM_MAX_CONCURRENT_TTS_PER_SESSION=3

# 是否将消息正文写入日志。默认关闭，仅记录长度。
ODM_LOG_MESSAGE_BODY=false

ODM_LOG_LEVEL=INFO
